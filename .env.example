# 이 파일을 .env로 복사한 뒤 본인 Supabase 프로젝트 값을 넣으세요.
# 비워 두면 로그인 없이 이 브라우저에만 저장하는 로컬 모드로 실행됩니다.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Supabase에서 켠 소셜 로그인만 쉼표로 적습니다. 예: google,kakao
VITE_AUTH_PROVIDERS=

# 배포 주소입니다. 공유 미리보기, canonical, sitemap에 쓰입니다. 예: https://example.vercel.app
VITE_SITE_URL=

# 개인정보 처리방침에 표시할 문의 이메일입니다.
VITE_CONTACT_EMAIL=

# 웹 푸시 공개 키(브라우저를 닫아도 알림). supabase/vapid-keys.local.txt의 VAPID_PUBLIC_KEY. 비워 두면 탭이 열려 있을 때만 알림
VITE_VAPID_PUBLIC_KEY=
